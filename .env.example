# Variables d'environnement de tout le projet, en un seul fichier.
#
#   ./scripts/env.sh init       copie ce modèle en .env et génère les secrets marqués __GEN_*__
#   ./scripts/env.sh dispatch   écrit api/.env et web/.env à partir de .env
#
# Une ligne « # @cible » indique où vont les variables qui la suivent (api, web, ou api,web).
# Ne jamais éditer api/.env ni web/.env à la main : ils sont réécrits par dispatch.
#
# Marqueurs remplacés par init :
#   __GEN_HEX__      64 caractères hexadécimaux
#   __GEN_TOKEN__    86 caractères base64 url-safe
#   __GEN_FERNET__   clé Fernet (32 octets en base64 url-safe)

# ═══════════════════════════════ Partagé ═══════════════════════════════
# @api,web
# Signature du webhook de revalidation du site (même valeur des deux côtés)
REVALIDATE_SECRET=__GEN_HEX__

# ═══════════════════════════════ API ═══════════════════════════════
# @api
# development | test | staging | production
ENV=development
DEBUG=True
SECRET_KEY=__GEN_TOKEN__
# Clé de signature des JWT, différente de SECRET_KEY. À changer au moins une fois par an.
JWT_SIGNING_KEY=__GEN_TOKEN__
ALLOWED_HOSTS=localhost,api.localhost,127.0.0.1,10.0.2.2
TRUSTED_PROXY_COUNT=1
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=
# En dev, compose.yml fournit ces deux URL et elles sont ignorées ici
DATABASE_URL=
REDIS_URL=

# Données de santé : clés Fernet séparées par des virgules (la première chiffre).
# À SAUVEGARDER HORS DU SERVEUR : leur perte rend les données illisibles.
FIELD_ENCRYPTION_KEYS=__GEN_FERNET__

# Démo (refusé en production)
SEED_DEMO=true

# Connexion Google / Apple : audiences acceptées des id_token
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# Cloudflare Turnstile (vide en dev = vérification désactivée)
TURNSTILE_SECRET_KEY=

OPENAPI_CONTRACT_PATH=

# Paiements et stores
PAYMENTS_SECRET_KEY=
PAYMENTS_WEBHOOK_SECRET=
GOOGLE_PLAY_PACKAGE_NAME=app.omeo
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PUBSUB_AUDIENCE=
GOOGLE_PUBSUB_SERVICE_ACCOUNT=
APPLE_BUNDLE_ID=app.omeo
APPLE_ROOT_CA_PEM=

# Push (vide = désactivées)
FIREBASE_CREDENTIALS_JSON=

# Emails
WEB_BASE_URL=http://localhost
DEFAULT_FROM_EMAIL=Omeo <no-reply@my-omeo.app>
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# IA (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=
OPENROUTER_TEXT_MODEL=
FOODSCAN_VISION_MODEL=

# Stockage S3 (MinIO en dev)
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://s3.localhost
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=omeo
S3_SECRET_ACCESS_KEY=omeo-dev-secret
S3_PRIVATE_BUCKET=omeo-private
S3_PUBLIC_BUCKET=omeo-public

# Observabilité (vide = Sentry désactivé)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# ═══════════════════════════════ Site ═══════════════════════════════
# @web
# mock (données simulées) ou api
DATA_SOURCE=mock
SITE_URL=http://localhost
API_URL_INTERNAL=http://api:8000
# Clé publique Turnstile
TURNSTILE_SITE_KEY=
PAYMENT_ORIGINS=

# Google OAuth (redirection : ${SITE_URL}/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple (clé .p8 sur une ligne, retours à la ligne remplacés par \n)
APPLE_SERVICE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

ANDROID_PACKAGE=app.omeo
IOS_APP_ID=6740000000

# Mesure d'audience : none, plausible ou umami
ANALYTICS_PROVIDER=none
ANALYTICS_SCRIPT_URL=
ANALYTICS_EVENT_URL=
ANALYTICS_SITE_ID=

MOCK_LATENCY_MS=300
