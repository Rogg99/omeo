# Fins de ligne LF partout (fichiers exécutés dans des conteneurs Linux)
* text=auto eol=lf

# Scripts Windows
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binaires
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.ttf binary
*.woff binary
*.woff2 binary
*.jar binary
