# ───────── Général ─────────
# development | test | staging | production (seed_demo et la doc Swagger sont refusés en production)
ENV=development
SECRET_KEY=change-me
# Clé de signature des JWT (par défaut SECRET_KEY). À changer au moins une fois par an.
JWT_SIGNING_KEY=
DEBUG=True
# api.localhost : via nginx ; 10.0.2.2 : émulateur Android ; ajouter l'IP du PC pour un vrai téléphone
ALLOWED_HOSTS=localhost,api.localhost,127.0.0.1,10.0.2.2
# DATABASE_URL et REDIS_URL sont fournis par compose.yml
# Nombre de proxys de confiance devant l'API (nginx = 1) : sert à lire l'IP réelle dans X-Forwarded-For
TRUSTED_PROXY_COUNT=1
LOG_LEVEL=INFO
# Vide : le web et l'admin passent par leur proxy serveur, le navigateur n'appelle jamais l'API
CORS_ALLOWED_ORIGINS=

# ───────── Données de santé ─────────
# Clés Fernet (32 octets en base64 url-safe), séparées par des virgules. La première chiffre, les autres
# déchiffrent seulement (rotation). Générer : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEYS=

# ───────── Démo ─────────
# Données de démo au démarrage (dev uniquement, refusé en production)
SEED_DEMO=true

# ───────── Connexion Google / Apple ─────────
# Identifiants clients OAuth acceptés comme audience des id_token (Android, iOS, web), séparés par des virgules
GOOGLE_CLIENT_IDS=
# Bundle ID iOS et Services ID Apple acceptés comme audience
APPLE_CLIENT_IDS=

# ───────── Captcha (formulaires publics) ─────────
# Clé secrète Cloudflare Turnstile. Vide en dev = vérification désactivée ; obligatoire en production.
TURNSTILE_SECRET_KEY=

# ───────── Emails ─────────
# Base des liens envoyés par email (vérification, réinitialisation)
WEB_BASE_URL=http://localhost
DEFAULT_FROM_EMAIL=Omeo <no-reply@omeo.app>
# Console en dev ; django.core.mail.backends.smtp.EmailBackend en prod
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# ───────── IA (OpenRouter) ─────────
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=
OPENROUTER_TEXT_MODEL=
# Scan des repas (apps/foodscan). Vide = OPENROUTER_VISION_MODEL
FOODSCAN_VISION_MODEL=

# ───────── Stockage S3 ─────────
# MinIO en dev (voir compose.yml). L'API parle à minio:9000 ; les clients reçoivent des URL signées sur s3.localhost
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://s3.localhost
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=omeo
S3_SECRET_ACCESS_KEY=omeo-dev-secret
S3_PRIVATE_BUCKET=omeo-private
S3_PUBLIC_BUCKET=omeo-public

# ───────── Observabilité ─────────
# Vide = Sentry désactivé. Les données personnelles sont retirées avant envoi (apps/core/logging.py).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
