# Site Omeo — variables serveur (aucune n'est envoyée au navigateur : pas de NEXT_PUBLIC_*).
# Copier en web/.env pour le développement. Validées au démarrage par src/server/env-schema.ts.

# Source des données : "mock" (données simulées, paiement simulé) ou "api" (API réelle).
# Le mode mock est refusé par `next build` : un build de production utilise toujours l'API.
DATA_SOURCE=mock

# Adresse publique du site (liens absolus, canoniques, retours de paiement, contrôle d'Origin).
SITE_URL=http://localhost

# Adresse de l'API sur le réseau Docker. Jamais exposée au navigateur. Requise avec DATA_SOURCE=api.
API_URL_INTERNAL=http://api:8000

# Secret partagé avec l'API pour signer le webhook de revalidation (/hooks/revalidate),
# 32 caractères minimum. Requis avec DATA_SOURCE=api.
REVALIDATE_SECRET=

# Clé publique Cloudflare Turnstile (le jeton est vérifié par l'API). Requise avec DATA_SOURCE=api.
TURNSTILE_SITE_KEY=

# Origines de l'agrégateur de paiement autorisées par la CSP (form-action), séparées par des virgules.
PAYMENT_ORIGINS=

# Connexion Google (OAuth « Web application », redirection : ${SITE_URL}/auth/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple (Services ID, redirection : ${SITE_URL}/auth/apple/callback).
APPLE_SERVICE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Clé privée .p8 sur une ligne, retours à la ligne remplacés par \n.
APPLE_PRIVATE_KEY=

# Stores (liens des boutons, du QR code et des invitations).
ANDROID_PACKAGE=app.omeo
IOS_APP_ID=6740000000

# Mesure d'audience servie depuis le site (/stats), chargée après consentement : none, plausible ou umami.
ANALYTICS_PROVIDER=none
# Script du fournisseur (ex. https://plausible.io/js/script.js) et point d'envoi des événements
# (ex. https://plausible.io/api/event ou https://umami.example/api/send).
ANALYTICS_SCRIPT_URL=
ANALYTICS_EVENT_URL=
# Identifiant du site chez Umami (inutile pour Plausible).
ANALYTICS_SITE_ID=

# Mode mock uniquement : latence simulée de chaque appel, en millisecondes.
MOCK_LATENCY_MS=300
